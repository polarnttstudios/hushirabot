# ====== BOT ======
DISCORD_TOKEN=coloque_o_token_do_bot_aqui
CLIENT_ID=id_da_aplicacao_do_bot

# ID do canal onde o bot manda os erros automaticamente (deixe vazio pra desativar)
LOG_CHANNEL_ID=

# Detecção automática de anti-raid (opcional, tem valor padrão se deixar vazio)
RAID_JOIN_THRESHOLD=6
RAID_JOIN_WINDOW_MS=10000

# IDs de servidores (guilds) onde os comandos aparecem instantaneamente (dev/teste).
# Deixe vazio para registrar tudo globalmente (demora até 1h para propagar).
DEV_GUILD_IDS=

# ====== DASHBOARD WEB ======
# Se DASHBOARD_ENABLED=false, o "node index.js" só sobe o bot (sem o painel),
# e você roda o painel separado com "npm run dashboard" se quiser.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
# Usuário e senha do painel — só quem tiver isso acessa
DASHBOARD_USER=admin
# Gere o hash com: node dashboard/gerar-senha.js suaSenhaForte
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=troque_por_uma_string_aleatoria_bem_grande

# ====== BANCO DE DADOS ======
DATABASE_PATH=./database/bot.db
